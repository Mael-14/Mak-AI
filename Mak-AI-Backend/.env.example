# Backend Environment Variables
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Firebase Configuration
# Option 1: Use service account key file (for development)
# Download serviceAccountKey.json from Firebase Console:
# Project Settings > Service Accounts > Generate new private key
# Place the file in the Mak-AI-Backend root directory

# Option 2: Use environment variable (for production/cloud deployment)
# Copy the entire JSON content from serviceAccountKey.json and paste it here as a single line
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project-id",...}

# Optional: Firebase Database URL (usually auto-detected from service account)
# FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# CORS Configuration (if needed)
# FRONTEND_URL=http://localhost:19006

